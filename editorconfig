root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{yml,yaml}]
indent_size = 2

[*.json]
indent_size = 2

[*.xml]
indent_size = 2

[*.sql]
indent_size = 4

[*.java]
indent_style = space
indent_size = 4
continuation_indent_size = 8

[*.kt]
indent_size = 4

[*.{ts,tsx,js,jsx}]
indent_size = 2

[*.vue]
indent_size = 2

[*.css]
indent_size = 2

[*.scss]
indent_size = 2

[*.html]
indent_size = 2

[*.properties]
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.ps1]
indent_style = space
indent_size = 4

[Dockerfile]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.feature]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf

