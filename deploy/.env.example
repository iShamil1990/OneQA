# Copy to a local .env file. Never commit real credentials.
POSTGRES_PASSWORD=change-this-to-a-long-random-secret
ONEQA_SECURITY_JWK_SET_URI=https://identity.example.internal/realms/oneqa/protocol/openid-connect/certs
ONEQA_SECURITY_ISSUER=https://identity.example.internal/realms/oneqa
ONEQA_SECURITY_AUDIENCE=oneqa-api
ONEQA_HTTP_PORT=8080
# Cloud additionally requires DB_URL, DB_USERNAME, DB_PASSWORD.

# Optional local Keycloak identity overlay (deploy/compose.identity.yml)
KEYCLOAK_DB_PASSWORD=replace-with-a-different-long-random-secret
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-third-long-random-secret
KEYCLOAK_HOSTNAME=https://identity.example.internal
KEYCLOAK_HTTP_PORT=8081
